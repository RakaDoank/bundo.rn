{
	"name": "bundo.rn",
	"version": "0.0.2",
	"description": "Let's bundo manages your React Native app for macOS",
	"license": "MIT",
	"author": "RakaDoank <rakaaudira@gmail.com> (https://github.com/RakaDoank)",
	"homepage": "https://github.com/RakaDoank/bundo.rn",
	"repository": {
		"type": "git",
		"url": "https://github.com/RakaDoank/bundo.rn.git",
		"directory": "packages/bundo.rn"
	},
	"scripts": {
		"build": "bun ./_scripts/build.mts"
	},
	"bin": {
		"bundo": "./bin.mjs",
		"bundo.rn": "./bin.mjs"
	},
	"files": [
		"bin.mjs",
		"lib",
		"src",
		"!*.tsbuildinfo"
	],
	"exports": {
		".": {
			"import": "./lib/module/index.js",
			"require": "./lib/commonjs/index.js",
			"types": "./lib/typescript/index.d.ts"
		},
		"./appgen": {
			"import": "./lib/module/subpaths/appgen/index.js",
			"require": "./lib/commonjs/subpaths/appgen/index.js",
			"types": "./lib/typescript/subpaths/appgen/index.d.mts"
		}
	},
	"peerDependencies": {
		"react-native-macos": "^0.81"
	},
	"devDependencies": {
		"@babel/core": "^7",
		"@babel/plugin-transform-export-namespace-from": "8.0.1",
		"@babel/preset-env": "^7",
		"@babel/runtime": "^7",
		"@react-native-community/cli": "^20",
		"bundo-appgen": "workspace:*",
		"yargs": "catalog:"
	}
}
