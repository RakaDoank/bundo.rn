{
	"name": "bundo.rn",
	"description": "Let's bundo manages your React Native app for macOS and Windows",
	"version": "0.0.0",
	"license": "MIT",
	"private": true,
	"scripts": {
		"code-check": "npm run type-check && npm run lint",
		"lint": "eslint",
		"prepare": "husky",
		"type-check": "tsc --build"
	},
	"workspaces": {
		"catalog": {
			"@rnx-kit/metro-config": "2.2.5",
			"@rnx-kit/metro-resolver-symlinks": "0.3.2",
			"yargs": "^18",
			"zod": "^4"
		},
		"packages": [
			"packages/*",
			"playground/*",
			"!playground/create-bundo-app"
		]
	},
	"devDependencies": {
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@inquirer/prompts": "8.7.2",
		"@react-native/eslint-config": "0.85.3",
		"@stylistic/eslint-plugin": "5.10.0",
		"@types/bun": "^1",
		"@types/node": "^24",
		"@types/react": "19.3.0",
		"@types/semver": "^7.8.0",
		"@types/yargs": "17.0.35",
		"bundo-appgen": "workspace:*",
		"create-bundo-app": "workspace:*",
		"eslint": "10.12.0",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-react-native": "^5.0.0",
		"globals": "17.13.0",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"react-native-builder-bob": "0.43.1",
		"semver": "^7.8.5",
		"tsx": "4.23.15",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.1",
		"yaml": "2.9.1"
	},
	"engines": {
		"bun": "^1.4.x",
		"node": ">=24"
	}
}
